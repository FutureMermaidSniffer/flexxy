# FlexJobs Development Environment Configuration
NODE_ENV=development
PORT=3003

# Database Configuration - Docker setup
DB_HOST=flexjobs-db
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=flexjobs_db
DB_PORT=5432

# Session Security
SESSION_SECRET=dev-super-secret-session-key-here

# JWT Secret
JWT_SECRET=dev_super_secret_jwt_key_here_make_it_very_long_and_secure

# Site Configuration
SITE_URL=http://localhost:3003
FRONTEND_URL=http://localhost:3003

# CORS Configuration
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3003,http://127.0.0.1:3000,http://127.0.0.1:3003

# Rate Limiting
RATE_LIMIT_WINDOW=15
RATE_LIMIT_MAX=100
STRICT_RATE_LIMIT_MAX=5

# Logging Level
LOG_LEVEL=debug

# Admin user (for development)
ADMIN_EMAIL=admin@flexjobs.local
ADMIN_PASSWORD=admin123

# Upload Configuration
UPLOAD_PATH=./uploads
MAX_FILE_SIZE=5242880
