# FlexJobs Production Environment Variables
# Usage: cp .env.production .env && npm start

# Application Configuration
NODE_ENV=development
PORT=3005
API_HOST=localhost
API_PORT=3005

# Domain & SSL
DOMAIN=flexjobseu.com
SSL_EMAIL=admin@flexjobseu.com

# CORS Configuration - CRITICAL FOR AUTH
ALLOWED_ORIGINS=https://flexjobseu.com,http://flexjobseu.com,https://www.flexjobseu.com,http://www.flexjobseu.com,http://localhost:3005,http://127.0.0.1:3005,http://localhost:3000,http://127.0.0.1:3000


# Database Configuration - PostgreSQL defaults for production
DB_HOST=localhost
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=flexjobs_db
DB_PORT=5433
# Session Management (Redis disabled - using memory store)
USE_REDIS=false

# Security (Generate with: openssl rand -base64 32)
JWT_SECRET=d00e381babdf3a26386e9ce3a4ea24a2
SESSION_SECRET=41ee08831b60497df51262e1eef37a1c

# Admin Configuration
ADMIN_EMAIL=admin@flexjobs.com
ADMIN_PASSWORD=GenerateSecureAdminPassword123!

# Logging
LOG_LEVEL=info

# Session Store
USE_REDIS=false
