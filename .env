# FlexJobs Environment Configuration
NODE_ENV=development
PORT=3003

# Database Configuration
DB_HOST=localhost
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=flexjobs_db
DB_PORT=5433

# Session Security
SESSION_SECRET=your-super-secret-session-key-here

# JWT Secret
JWT_SECRET=your_super_secret_jwt_key_here_make_it_very_long_and_secure

# CORS Configuration
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3003,http://127.0.0.1:3000,http://127.0.0.1:3003

# Rate Limiting
RATE_LIMIT_WINDOW=15
RATE_LIMIT_MAX=100
STRICT_RATE_LIMIT_MAX=5

# Logging Level
LOG_LEVEL=info

# Admin user (optional)
# ADMIN_EMAIL=admin@example.com
# ADMIN_PASSWORD=secure_password

# Upload Configuration
UPLOAD_PATH=./uploads
MAX_FILE_SIZE=5242880
