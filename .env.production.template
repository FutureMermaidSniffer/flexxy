# PRODUCTION ENVIRONMENT CONFIGURATION
# =====================================
# 
# SECURITY NOTICE:
# - Never commit this file to version control
# - Use strong, unique passwords for production
# - Rotate secrets regularly
# - Use environment-specific secret management
#
# File: .env.production

# Environment
NODE_ENV=production

# Database Configuration (Consistent Port: 5433)
DB_HOST=postgres
DB_PORT=5433
DB_NAME=flexjobs_prod
DB_USER=flexjobs_user
DB_PASSWORD=${SECURE_DB_PASSWORD_HERE}

# Security Secrets (MUST BE CHANGED IN PRODUCTION)
SESSION_SECRET=${SECURE_SESSION_SECRET_64_CHARS_MIN}
JWT_SECRET=${SECURE_JWT_SECRET_64_CHARS_MIN}

# Site Configuration
SITE_URL=https://your-domain.com
SITE_NAME=FlexJobs

# Email Configuration (Production SMTP)
EMAIL_HOST=${SMTP_HOST}
EMAIL_PORT=587
EMAIL_USER=${SMTP_USER}
EMAIL_PASSWORD=${SMTP_PASSWORD}
EMAIL_FROM=noreply@your-domain.com

# Admin Configuration (Temporary - Delete After Setup)
# ADMIN_EMAIL=admin@your-domain.com
# ADMIN_PASSWORD=${TEMP_ADMIN_PASSWORD}

# Feature Flags
ENABLE_REGISTRATION=true
ENABLE_EMAIL_VERIFICATION=true

# Logging
LOG_LEVEL=error
ENABLE_DB_LOGGING=false

# Security Headers
ENABLE_HELMET=true
ENABLE_CORS=true

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# IMPORTANT SECURITY NOTES:
# ========================
# 1. Replace ALL ${...} placeholders with actual secure values
# 2. Use password managers to generate strong secrets
# 3. Minimum 64 characters for JWT_SECRET and SESSION_SECRET
# 4. Use environment-specific database credentials
# 5. Enable SSL/TLS in production
# 6. Set up proper backup and monitoring
# 7. Remove commented admin credentials after first login
#
# GENERATE SECURE SECRETS:
# openssl rand -base64 64  # For JWT_SECRET
# openssl rand -base64 64  # For SESSION_SECRET
# openssl rand -base64 32  # For DB_PASSWORD
