# FlexJobs Production Environment Variables
# Usage: cp .env.production .env && docker-compose -f docker-compose.nginx.yml up -d

# Domain & SSL
DOMAIN=yourdomain.com
SSL_EMAIL=admin@yourdomain.com

# Database
DB_USER=flexjobs_user
DB_PASSWORD=GenerateSecurePassword123!
DB_NAME=flexjobs_production

# Redis
REDIS_PASSWORD=GenerateSecureRedisPassword123!

# Security (Generate with: openssl rand -base64 32)
JWT_SECRET=GenerateSecureJWTSecret32CharactersLong!
SESSION_SECRET=GenerateSecureSessionSecret32CharactersLong!

# Admin
ADMIN_EMAIL=admin@yourdomain.com
ADMIN_PASSWORD=GenerateSecureAdminPassword123!
