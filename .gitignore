# Dependencies
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Environment variables
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# Operating System
.DS_Store
Thumbs.db

# IDE/Editor
.vscode/
.idea/
*.swp
*.swo
*~

# Logs
logs/
*.log

# Runtime data
pids/
*.pid
*.seed
*.pid.lock

# Coverage directory used by tools like istanbul
coverage/

# Build outputs
dist/
build/
.tmp/

# Database
*.sqlite
*.sqlite3
*.db

# Temporary files
.cache/
.temp/
.tmp/

# Package manager lockfiles (optional - you might want to keep package-lock.json)
# package-lock.json
# yarn.lock

# Windows specific
*.lnk

# macOS specific
.DS_Store
.AppleDouble
.LSOverride

# Linux specific
*~

# Large files that shouldn't be committed to GitHub
*.mp4
*.mov
*.avi
*.mkv
*.wmv

# Large images (over 1MB) - keep small versions
frontend/images/**/*.jpg
frontend/images/**/*.jpeg
frontend/images/**/*.png
frontend/images/**/*.gif
!frontend/images/**/thumbnail_*
!frontend/images/**/small_*
!frontend/images/**/icon_*

# Backup files
*.backup
*.bak
*.old

# Asset optimization generated files
*_optimized.*
*_compressed.*

# Deployment packages
deployment.tar.gz
