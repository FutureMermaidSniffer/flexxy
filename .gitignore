# Dependencies
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Environment variables (Keep templates and production examples)
# .env
# .env.local
# .env.development.local
# .env.test.local
# Note: .env.production, .env.example are INCLUDED for production

# Operating System
.DS_Store
Thumbs.db

# IDE/Editor
.vscode/
.idea/
*.swp
*.swo
*~

# Logs
logs/
*.log

# Runtime data
pids/
*.pid
*.seed
*.pid.lock

# Coverage directory used by tools like istanbul
coverage/

# Build outputs
dist/
build/
.tmp/

# Database
*.sqlite
*.sqlite3
*.db

# Temporary files
.cache/
.temp/
.tmp/

# Package manager lockfiles (INCLUDE for production)
# package-lock.json and yarn.lock are now INCLUDED

# Windows specific
*.lnk

# macOS specific
.DS_Store
.AppleDouble
.LSOverride

# Linux specific
*~

# Large files that shouldn't be committed to GitHub
# *.mp4
# *.mov
# *.avi
# *.mkv
# *.wmv

# Large images (over 1MB) - keep small versions
# frontend/images/**/*.jpg
# frontend/images/**/*.jpeg
# frontend/images/**/*.png
# frontend/images/**/*.gif
# !frontend/images/**/thumbnail_*
# !frontend/images/**/small_*
# !frontend/images/**/icon_*

# Backup files (.backup extension files are excluded)
*.backup
*.bak
*.old

# Asset optimization generated files (exclude optimized versions)
*_optimized.*
*_compressed.*

# Runtime deployment packages (exclude deployment archives)
deployment.tar.gz

# Production secrets that should never be committed
.env.production.local
.env.secrets
default.conf


# === PRODUCTION FILES (EXPLICITLY INCLUDED) ===
# The following files are REQUIRED for production deployment and are included:
# - package.json & package-lock.json
# - .env.example, .env.production
# - All deployment guides and scripts in DEPLOYMENT_* files
# - GitHub Actions workflows (.github/workflows/)
# - Production configuration and deployment scripts (scripts/deploy-*.sh)

# === DEVELOPMENT/TEST FILES (EXCLUDED FROM PRODUCTION) ===
# Exclude test files from production deployments
test-*.js
**/test-*.js
**/test-*.html

# Keep these important test utilities for debugging
!database/test-connection.js
!scripts/test-scraping-setup.js
