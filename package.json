{
  "name": "flexjobs",
  "version": "1.0.0",
  "description": "A full-stack remote job board application built with Node.js, Express, PostgreSQL, and Bootstrap",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "migrate": "node database/migration-system.js migrate",
    "migrate:status": "node database/migration-system.js status",
    "migrate:rollback": "node database/migration-system.js rollback",
    "migrate:generate": "node database/generate-migration.js",
    "migrate:transition": "node database/transition-migrations.js",
    "migrate:legacy": "node database/migrate.js",
    "rollback": "node database/rollback.js",
    "db:setup": "npm run migrate",
    "db:reset": "npm run rollback && npm run migrate",
    "scrape:jobs": "node scripts/comprehensive-scraper.js",
    "scrape:basic": "node scripts/run-scraper.js",
    "scrape:google": "node scripts/google-jobs-scraper.js",
    "scrape:schedule": "node scripts/comprehensive-scraper.js --schedule",
    "assets:upload": "node scripts/upload-large-assets.js",
    "assets:sync": "node scripts/dev-assets.js sync",
    "assets:check": "node scripts/dev-assets.js check",
    "assets:list": "node scripts/dev-assets.js list",
    "test": "echo \"No tests specified\" && exit 0",
    "docker:prod": "docker-compose --env-file .env.docker up -d"
  },
  "keywords": [
    "jobs",
    "remote",
    "flexjobs",
    "employment",
    "career",
    "nodejs",
    "express",
    "postgresql"
  ],
  "author": "FlexJobs Team",
  "license": "MIT",
  "type": "commonjs",
  "dependencies": {
    "axios": "^1.11.0",
    "bcryptjs": "^3.0.2",
    "cheerio": "^1.1.2",
    "colors": "^1.4.0",
    "cors": "^2.8.5",
    "dotenv": "^17.2.1",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.1",
    "express-session": "^1.18.2",
    "express-validator": "^7.2.1",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.0.2",
    "node-cron": "^3.0.3",
    "nodemailer": "^7.0.5",
    "passport": "^0.7.0",
    "passport-apple": "^2.0.2",
    "pg": "^8.16.3",
    "winston": "^3.17.0"
  },
  "devDependencies": {
    "nodemon": "^3.1.10"
  }
}
